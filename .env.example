# Kosongkan untuk dev (Vite proxy /api -> localhost:3001)
# Isi untuk production, contoh: http://192.168.0.110:3001
VITE_API_URL=""

# Bypass Auth untuk mode pengembangan (tanpa perlu login / setup profile)
VITE_BYPASS_AUTH="false"

# Gunakan data mock lokal (.mock) alih-alih API asli
VITE_USE_MOCK="true"
